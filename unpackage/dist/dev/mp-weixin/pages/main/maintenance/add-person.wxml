<view class="content"><view class="input-wrapper"><view class="uni-flex-btw"><text class="title uni-cell-20">联系人：</text><input class="uni-cell-80" type="text" focus="{{true}}" clearable="{{true}}" placeholder="请输入联系人" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['form']]]]]}}" value="{{form.name}}" bindinput="__e"/></view><view class="uni-flex-btw"><text class="title uni-cell-20">手机号：</text><input class="uni-cell-80" type="number" clearable="{{true}}" placeholder="请输入联系人手机号" data-event-opts="{{[['input',[['__set_model',['$0','tel','$event',[]],['form']]]]]}}" value="{{form.tel}}" bindinput="__e"/></view></view><view class="uni-margin-top-150"><button class="btn" plain="{{true}}" data-event-opts="{{[['tap',[['register',['$event']]]]]}}" bindtap="__e">添加联系人</button></view></view>