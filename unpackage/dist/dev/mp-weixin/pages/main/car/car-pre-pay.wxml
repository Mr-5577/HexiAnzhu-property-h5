<view class="pay"><view class="uni-flex-center"><block wx:if="{{$root.g0!=0}}"><view class="uni-cell-90 est-content"><view class="title uni-font-36 uni-font-bold uni-flex"><view>{{'物业预缴（'+preCarData.label+'）'}}</view><view data-event-opts="{{[['tap',[['chooseAllPay',['$event']]]]]}}" class="icon-rights" bindtap="__e"><text hidden="{{!(chooseAll)}}">✔</text></view></view><view class="uni-flex-btw est-content-header"><view class="uni-cell-40">缴费月份</view><view class="uni-cell-20">金额</view><view class="uni-cell-20">缴费类型</view></view><block wx:for="{{generatedList}}" wx:for-item="items" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['choosePay',['$0',index],[[['generatedList','',index]]]]]]]}}" class="uni-flex-btw est-content-header" bindtap="__e"><view hidden="{{!(items.isChoose)}}" class="icon-right">✔</view><view class="icon-right"></view><view class="uni-cell-40">{{items.ymonth}}</view><view class="uni-cell-20">{{items.money}}</view><view class="uni-cell-20">物管费</view></view></block></view></block></view><view class="uni-flex-center" style="margin-bottom:100rpx;"><block wx:if="{{preCarData.label}}"><view class="uni-cell-90 est-content"><view class="title uni-font-36 uni-font-bold">{{"车位预缴（"+preCarData.label+"）"}}</view><view class="uni-flex-btw est-content-header"><view class="uni-cell-40">开始月份</view><view class="uni-cell-20">费用/月</view><view class="uni-cell-20">选择缴费</view></view><view class="uni-flex-btw est-content-header"><view class="uni-cell-40">{{preCarData.yjmonth}}</view><view class="uni-cell-20">{{preCarData.fee}}</view><view class="uni-cell-20 uni-flex-btw"><view data-event-opts="{{[['tap',[['minus',['$event']]]]]}}" class="minus colorOrange" bindtap="__e">-</view><text style="padding-left:20rpx;padding-right:20rpx;">{{monthNum}}</text><view data-event-opts="{{[['tap',[['append',['$event']]]]]}}" class="minus colorOrange" bindtap="__e">+</view></view></view></view></block></view><view class="foot-pays uni-flex-btw"><view class="uni-cell-70 money"> 合计缴费金额 ： <text class="uni-font-bold">{{carPrePay}}</text></view><button class="{{['uni-cell-30','to-pay','bg-gradient-btn',(disabled==true)?'po-event-none':'']}}" disabled="{{disabled}}" data-event-opts="{{[['tap',[['payment',['$event']]]]]}}" bindtap="__e">去支付</button></view></view>