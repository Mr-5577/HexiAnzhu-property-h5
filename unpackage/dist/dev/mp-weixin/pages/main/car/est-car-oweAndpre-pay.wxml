<view class="pay"><block wx:if="{{$root.g0!=0}}"><view><view class="uni-flex-center qf-wrapper"><view class="uni-cell-94 est-content"><view class="title uni-font-36 uni-font-bold uni-flex"><view>{{"车位欠费（"+preCarData.label+"）"}}</view></view><view class="uni-flex-btw est-content-header"><view class="uni-cell-40">缴费月份</view><view class="uni-cell-30">金额</view><view class="uni-cell-30">缴费类型</view></view><block wx:for="{{carDetailList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="uni-flex-btw est-content-header"><checkbox style="transform:scale(0.7);" disabled="{{item.disable}}" checked="{{item.checked}}" value="{{item.id}}" data-event-opts="{{[['tap',[['checkBoxs',['$0'],[[['carDetailList','',index]]]]]]]}}" bindtap="__e"></checkbox><view class="uni-cell-40">{{item.key}}</view><view class="uni-cell-30">{{item.money}}</view><view class="uni-cell-30">{{item.title}}</view></view></block><view class="heji"> 欠费合计： <text style="font-weight:600;">{{carData.summoney+' '}}</text> 元 </view></view></view></view></block><view><view class="uni-flex-center"><block wx:if="{{preCarData.label}}"><view class="uni-cell-94 est-content"><view class="title uni-font-bold">{{"车位预缴（"+preCarData.label+"）"}}</view><view class="uni-flex-btw est-content-header"><view class="uni-cell-40">开始月份</view><view class="uni-cell-30">费用/月</view><view class="uni-cell-30">选择缴费</view></view><view class="uni-flex-btw est-content-header"><view class="uni-cell-40">{{preCarData.yjmonth}}</view><view class="uni-cell-30">{{preCarData.fee}}</view><view class="uni-cell-30 uni-flex-btw"><view data-event-opts="{{[['tap',[['minus',['$event']]]]]}}" class="minus" bindtap="__e">-</view><text style="padding-left:20rpx;padding-right:20rpx;">{{monthNum}}</text><view data-event-opts="{{[['tap',[['append',['$event']]]]]}}" class="minus" style="background-color:#ffcf5a;" bindtap="__e">+</view></view></view><view class="heji"> 预缴合计： <text style="font-weight:600;">{{preCarData.fee*monthNum+' '}}</text> 元 </view></view></block></view><block wx:if="{{activityData}}"><view data-event-opts="{{[['tap',[['activeRule',['$event']]]]]}}" class="uni-flex-center" bindtap="__e"><view class="uni-cell-94"><view class="activity"> 预缴优惠活动 </view></view></view></block></view><block wx:if="{{$root.g1}}"><view class="foot-pays uni-flex-btw"><view class="uni-cell-70 money"> 合计缴费金额： <text class="uni-font-bold" style="color:#ffcf5a;">{{preMoney}}</text></view><button class="{{['uni-cell-30','to-pay',(disabled==true)?'po-event-none':'']}}" plain="{{true}}" disabled="{{disabled}}" data-event-opts="{{[['tap',[['payment',['$event']]]]]}}" bindtap="__e">去支付</button></view></block></view>