<view class="add-review"><view class="header"><view class="at-jie"><image src="/static/images/avatar.png" mode></image><view class="jie"><text class="name">{{uname}}</text><text class="label">专属管家</text><view class="text">{{address}}</view></view></view><view class="star"><text class="title">服务评分</text><view class="rate"><uni-rate bind:input="__e" vue-id="19d4d4f8-1" value="{{starValue}}" size="{{20}}" margin="{{10}}" data-event-opts="{{[['^input',[['__set_model',['','starValue','$event',[]]]]]]}}" bind:__l="__l"></uni-rate></view></view></view><block wx:if="{{false}}"><view class="labels"><block wx:for="{{labelList}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><text data-event-opts="{{[['tap',[['labSelect',['$0'],[[['labelList','id',item.id]]]]]]]}}" class="{{['lab-item',item.active?'active':'']}}" bindtap="__e">{{''+item.name+''}}</text></block></view></block><view class="other"><view class="title">其它评价</view><textarea class="text-input-area" placeholder="请填写评价内容" maxlength="140" data-event-opts="{{[['input',[['__set_model',['','content','$event',[]]]]]]}}" value="{{content}}" bindinput="__e"></textarea></view><view class="btn-wrapper"><view data-event-opts="{{[['tap',[['addReview',['$event']]]]]}}" class="btn" bindtap="__e">提交评价</view></view></view>