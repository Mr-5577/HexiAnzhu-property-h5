.housekeeper {
	min-height: 100vh;
	box-sizing: border-box;
	background-color: #fff;
}
.header {
	padding: 40rpx 24rpx;
	border-bottom: 30rpx solid #FAFAFA;
	text-align: center;
}
.header .avatar {
	width: 160rpx;
	height: 160rpx;
	display: inline-block;
}
.header .avatar image {
	width: 100%;
	height: 100%;
}
.header .user-name {
	font-size: 32rpx;
	font-weight: 600;
	line-height: 50rpx;
	color: #333;
	margin: 15rpx 0 20rpx;
}
.header .labels {
	display: inline-block;
	font-size: 24rpx;
	line-height: 34rpx;
	margin-bottom: 40rpx;
}
.header .labels .lab1 {
	margin-right: 40rpx;
	display: inline-block;
	padding: 4rpx 20rpx;
	color: #ffcf5a;
	background-color: #fcf6e5;
	border-radius: 4rpx;
}
.header .labels .lab2 {
	margin-right: 40rpx;
	padding: 4rpx 20rpx;
	color: #33b5ff;
	background-color: rgba(51,181,255,0.1);
	border-radius: 4rpx;
}
.header .labels .lab3 {
	padding: 4rpx 20rpx;
	color: #65d8bf;
	background-color: rgba(101,216,191,0.1);
	border-radius: 4rpx;
}
.header .btn-wrapper {
	display: flex;
	justify-content: space-between;
}
.header .btn-wrapper .hujiao,
.header .btn-wrapper .evaluate {
	font-size: 28rpx;
	line-height: 40rpx;
	color: #fff;
	background-color: #ffcf5a;
	border-radius: 4rpx;
	padding: 10rpx 20rpx;
}
.header .btn-wrapper .hujiao:active,
.header .btn-wrapper .evaluate:active {
	opacity: 0.6;
}
.header .btn-wrapper image {
	width: 64rpx;
	height: 64rpx;
}
.header .btn-wrapper image:active {
	opacity: 0.6;
}
.content-wrapper .text {
	padding: 10rpx 24rpx 0;
}
.content-wrapper .eval {
	padding: 30rpx 24rpx;
	border-top: 1px solid #ebebeb;
}
.content-wrapper .eval .eval-item {
	margin-bottom: 60rpx;
	display: flex;
}
.content-wrapper .eval .eval-item:last-child {
	margin-bottom: 0;
}
.content-wrapper .eval .eval-item image {
	width: 90rpx;
	height: 90rpx;
	margin-right: 20rpx;
}
.content-wrapper .eval .eval-item .intro-wrapper{
	flex: 1;
}
.content-wrapper .eval-item .intro-wrapper .introduce  {
	margin-bottom: 10rpx;
}
.content-wrapper .eval-item .intro-wrapper .introduce .name {
	font-size: 28rpx;
	line-height: 40rpx;
	color: #666;
	margin-right: 20rpx;
}
.content-wrapper .eval-item .intro-wrapper .introduce .date {
	font-size: 24rpx;
	line-height: 40rpx;
	color: #999;
}
.content-wrapper .eval-item .intro-wrapper .introduce .rate {
	float: right;
	height: 50rpx;
	line-height: 50rpx;
	padding: 9rpx 0;
	box-sizing: border-box;
}
.content-wrapper .eval-item .intro-wrapper .eval-text  {
	font-size: 28rpx;
	line-height: 42rpx;
	color: #333;
	text-align: justify;
}
.content-wrapper .service-area {
	padding: 30rpx 0;
	border-top: 1px solid #ebebeb;
}
.content-wrapper .service-area .adr-wrapper {
	padding: 0 24rpx;
	margin-bottom: 30rpx;
}
.content-wrapper .service-area .adr-wrapper .uni-icons {
	color: #999!important;
	margin-right: 10rpx;
}
.content-wrapper .service-area .adr-wrapper .title {
	font-size: 30rpx;
	color: #333;
	line-height: 42rpx;
}
.content-wrapper .service-area .b-wrapper {
}
.content-wrapper .service-area .b-item {
	display: inline-block;
	font-size: 30rpx;
	line-height: 42rpx;
	color: #ffcf5a;
	padding: 20rpx 40rpx;
	border: 1px solid #ffcf5a;
	margin: 0 24rpx 50rpx;
	border-radius: 6rpx;
}

