.add-review {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 160rpx;
  background-color: #fff;
}
.add-review .header {
  padding: 60rpx 24rpx;
  border-bottom: 30rpx solid #FAFAFA;
}
.add-review .header .at-jie {
  margin-bottom: 60rpx;
  display: flex;
}
.add-review .header .at-jie image {
  width: 120rpx;
  height: 120rpx;
  margin-right: 30rpx;
}
.add-review .header .at-jie .jie {
  flex: 1;
  padding-top: 10rpx;
}
.add-review .header .at-jie .jie .name {
  font-size: 30rpx;
  line-height: 42rpx;
  margin-right: 20rpx;
  font-weight: 600;
  vertical-align: middle;
}
.add-review .header .at-jie .jie .label {
  display: inline-block;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #ffcf5a;
  background-color: #fcf6e5;
  padding: 4rpx 20rpx;
  border-radius: 4rpx;
  vertical-align: middle;
}
.add-review .header .at-jie .jie .text {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333;
  margin-top: 10rpx;
}
.add-review .header .star > .title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 44rpx;
  margin-right: 30rpx;
}
.add-review .header .star .rate {
  display: inline-block;
}
.add-review .labels {
  padding: 40rpx 0 0;
  display: flex;
  flex-wrap: wrap;
}
.add-review .labels .lab-item {
  font-size: 28rpx;
  line-height: 40rpx;
  padding: 10rpx 40rpx;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 4rpx;
  margin: 0 24rpx 30rpx;
}
.add-review .labels .lab-item.active {
  padding: 8rpx 38rpx;
  border: 1px solid #ffcf5a;
  color: #ffcf5a;
  background-color: #fcf6e5;
}
.add-review .other {
  padding: 40rpx 24rpx 0;
}
.add-review .other .title {
  font-size: 30rpx;
  line-height: 44rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 40rpx;
}
.add-review .other .text-input-area {
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  color: #333;
  font-size: 26rpx;
  line-height: 36rpx;
  height: 240rpx;
  box-sizing: border-box;
  width: 100%;
  border: none;
}
.add-review .btn-wrapper {
  padding: 20rpx 24rpx 40rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  box-sizing: border-box;
}
.add-review .btn-wrapper .btn {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #fff;
  padding: 24rpx;
  background-color: #ffcf5a;
  border-radius: 6rpx;
  text-align: center;
}
