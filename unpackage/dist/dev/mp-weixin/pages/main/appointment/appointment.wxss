#appointment {
  font-family: "PingFang SC";
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
#appointment .content {
  flex: 1;
}
#appointment .content .header {
  border-top: 30rpx solid #F7F7F7;
  border-bottom: 30rpx solid #F7F7F7;
  background-color: #fff;
  padding: 0 24rpx;
}
#appointment .content .header .row {
  display: flex;
  height: 120rpx;
  align-items: center;
  color: #333;
  border-bottom: 1px solid #ebebeb;
  font-size: 32rpx;
}
#appointment .content .header .row .name {
  flex-shrink: 0;
  font-weight: 600;
}
#appointment .content .header .row .value {
  flex: 1;
}
#appointment .content .header .row .uni-icons {
  line-height: 42rpx;
}
#appointment .content .header .row:active {
  opacity: 0.8;
}
#appointment .content .header .row:last-child {
  border: none;
}
#appointment .content .user-info {
  padding: 0 24rpx;
}
#appointment .content .user-info .info-item {
  padding-top: 40rpx;
}
#appointment .content .user-info .info-item .name {
  font-weight: 600;
  font-size: 32rpx;
  color: #333;
  line-height: 44rpx;
  margin-bottom: 20rpx;
}
#appointment .content .user-info .info-item input {
  padding: 20rpx 0;
  color: #333;
  line-height: 42rpx;
  font-size: 30rpx;
  border-bottom: 1px solid #ebebeb;
}
#appointment .content .user-info .info-item:last-child {
  margin-bottom: 100rpx;
}
#appointment .btn-content {
  padding: 0 24rpx 100rpx;
}
#appointment .btn-content .my-btn {
  background-color: #ffcf5a;
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  padding: 24rpx 0;
  border-radius: 6rpx;
  border: none;
  outline: none;
}
#appointment .btn-content .my-btn:after {
  display: none;
}
