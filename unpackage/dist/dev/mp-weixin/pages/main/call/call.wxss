
.call {
	min-height: 100vh;
	background-color: #FAFAFA;
}
.header {
	padding: 70rpx 0 50rpx;
	text-align: center;
	background-color: #fff;
}
.header image {
	width: 144rpx;
	height: 144rpx;
}
.header .title {
	font-size: 32rpx;
	color: #333;
	line-height: 50rpx;
	font-weight: 600;
}
.content {
	margin-top: 30rpx;
	padding: 0 24rpx;
	background-color: #fff;
}
.content .content-item {
	font-size: 30rpx;
	line-height: 42rpx;
	color: #333;
	padding: 40rpx 0;
	border-bottom: 1px solid #ebebeb;
}
.content .content-item .tel {
	color: #ffcf5a;
}
.content .content-item:last-child {
	border-bottom: none;
}

