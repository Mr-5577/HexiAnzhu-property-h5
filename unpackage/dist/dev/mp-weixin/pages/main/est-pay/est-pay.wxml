" bindtap="__e"><view class="uni-flex-center uni-cell-100"><view class="uni-cell-100" style="display:flex;"><view class="uni-cell-75">{{''+item.room_ele[0].table_type+''}}</view><view class="uni-cell-20"><text>{{item.room_ele[0].allmoney}}</text></view></view></view></view></block></block></view></view></view><view class="uni-flex-center"><view class="uni-cell-95 uni-flex-btw"><view class="est-title uni-font-28 uni-font-bold">*点击费用项可查看费用更多详情</view></view></view></view></block>