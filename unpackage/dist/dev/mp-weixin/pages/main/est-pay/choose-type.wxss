
.wy-car-pay {
	background-color: #fff;
	min-height: 100vh;
}
.wy-wrapper {
	padding: 0 24rpx;
	border-bottom: 30rpx solid #fafafa;
}
.car-wrapper {
	padding: 0 24rpx;
}
.title {
	font-size: 32rpx;
	color: #333;
	line-height: 44rpx;
	font-weight: 600;
	padding: 30rpx 0;
}
.content {
	padding: 30rpx;
	background-color: #fafafa;
	position: relative;
	margin-bottom: 30rpx;
}
.code {
	font-size: 30rpx;
	line-height: 42rpx;
	color: #666;
	margin-bottom: 30rpx;
}
.area {
	font-size: 30rpx;
	line-height: 42rpx;
	color: #666;
}
.btn {
	position: absolute;
	top: 50%;
	right: 30rpx;
	-webkit-transform: translateY(-50%);
	        transform: translateY(-50%);
	border-radius: 8rpx;
	padding: 10rpx 44rpx;
	font-size: 28rpx;
	line-height: 40rpx;
	color: #ffcf5a !important;
	border: 1px solid #ffcf5a !important;
}
.btn:active {
	opacity: 0.6;
}

