<view class="wy-car-pay"><view class="wy-wrapper"><view class="title">物业费用</view><block wx:if="{{!datas.room}}"><view class="uni-empty">暂无物业信息！</view></block><block wx:else><view class="content"><view class="code">{{"房号："+(datas.room.roomnum?datas.room.roomnum:'')}}</view><view class="area">{{"面积："+(datas.room.buildareas?datas.room.buildareas:'')+"㎡"}}</view><button class="btn" plain="{{true}}" data-event-opts="{{[['tap',[['estPay',['$event']]]]]}}" bindtap="__e">缴费</button></view></block></view><view class="car-wrapper"><view class="title">车辆费用</view><block wx:if="{{$root.g0}}"><view class="uni-empty">暂无车辆信息！</view></block><block wx:else><view><block wx:for="{{datas.cars}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="content"><view class="code">{{"车位编号："+(item.plates?item.plates:'')}}</view><view class="area">{{"面积："+(item.area?item.area:'')+"㎡"}}</view><button class="btn" plain="{{true}}" data-event-opts="{{[['tap',[['carPay',['$0'],[[['datas.cars','',index]]]]]]]}}" bindtap="__e">缴费</button></view></block></view></block></view></view>