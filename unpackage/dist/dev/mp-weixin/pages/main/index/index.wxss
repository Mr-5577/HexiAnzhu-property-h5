page {
	background-color: #fff;
}
.main {
	background: #FAFAFA;
	min-height: calc(100vh - 150rpx);
}
.main-content {
	background: #ffffff;
}
.main-header {
	height: 150rpx;
	width: 100%;
	position: fixed;
	z-index: 1200;
	top: 0;
	left: 0;
	padding-left: 20rpx;
	box-sizing: border-box;
	background: #ffffff;
}
.s-pull-scroll .s-pull-down-wrap {
	background-color: #fff;
}
.swiper {
	height: 100%;
	border-radius: 10rpx;
	overflow: hidden;
	position: relative;
	z-index: 1000;
}
.swiper image {
	height: 100%!important;
	width: 100%!important;
}
.main-project {
	padding-top: 70rpx;
}
.main-score {
	background: #d8d8d8;
	border-radius: 20rpx;
	font-size: 18rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	margin: 10rpx;
}
.main-message {
	padding-top: 80rpx;
}
.main-message-icon {
	width: 40rpx;
	height: 40rpx;
}
.main-banner {
	height: 360rpx;
	width: 100%;
	padding-top: 20rpx;
}
.main-fct-btn {
	height: 180rpx;
	border-radius: 10rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	box-shadow: 0px 0px 10px 2px #C8C7CC;
}
.main-grad-8 {
	margin-top: 30rpx;
	padding-bottom: 30rpx;
}
.notice-wrapper {
	margin: 30rpx 20rpx;
	padding: 30rpx;
	background-color: #fff;
	display: flex;
	border-radius: 10rpx;
}
.notice-wrapper .notice-title {
	width: 140rpx;
	font-size: 32rpx;
	color: #fff;
	letter-spacing: 20rpx;
	padding: 20rpx 6rpx 20rpx 30rpx;
	border-radius: 10rpx;
	box-sizing: border-box;
	background-color: #ffcf5a;
}
.notice-wrapper .notice-content {
	flex: 1;
	margin-left: 30rpx;
	position: relative;
}
.notice-wrapper .notice-content .notice-item {
	position: absolute;
	top: 50%;
	left: 0;
	-webkit-transform: translateY(-50%);
	        transform: translateY(-50%);
}
.notice-wrapper .notice-content .notice-item .text {
	color: #999;
	overflow:hidden;
	text-overflow:ellipsis;
	display:-webkit-box;
	-webkit-line-clamp:3;
	-webkit-box-orient:vertical;
}
.main-notice {
	margin-top: 20rpx;
	display: flex;
	background: #FFFFFF;
	width: 100%;
	padding: 0 24rpx;
	box-sizing: border-box;
}
.main-notice image {
	height: 140rpx;
	width: 140rpx;
}
.empty-notice {
	line-height: 140rpx;
	color: #888888;
}
.image {
	width: 100rpx;
	height: 100rpx;
}
.text {
	font-size: 26rpx;
	margin-top: 10rpx;
}
.main-service {
	margin-top: 20rpx;
	border-radius: 10rpx;
	background: #ffffff;
}
.main-service .title {
	line-height: 100rpx;
	font-size: 30rpx;
	font-weight: bold;
	padding-left: 20rpx;
}
.user-list-cell {
	display: flex;
	justify-content: space-between;
	height: 100rpx;
	margin: 20rpx;
}
.user-list-cell-right {
	line-height: 80rpx;
	text-align: right;
}
.user-list-cell-right .text {
	background: #fcf5e5;
	color: #db9444;
	padding: 10rpx 20rpx 10rpx;
	border-radius: 30rpx;
}
.mark {
	font-size: 24rpx;
	color: #999999;
}
.main-topic {
	margin-top: 40rpx;
	border-radius: 10rpx;
	background: #ffffff;
}
.update-card {
	position: fixed;
	height: 100%;
	width: 100%;
}
.housekeeper {
	height: 180rpx;
	width: 95%;
	background: #FFFFFF;
	border-radius: 10rpx;
}
.housekeeper-header {
	height: 120rpx;
	width: 120rpx;
	border-radius: 10rpx;
}
.housekeeper-btn {
	height: 60rpx;
	width: 180rpx;
	line-height: 60rpx;
	background: #FFFFFF;
	border: 2rpx solid #ffbc19;
	border-radius: 4rpx;
	color: #ffbc19;
	font-size: 28rpx;
	text-align: center;
}
.housekeeper-btn:active {
	opacity: 0.6;
}
.pop_btn {
	border: none;
}
.recommend {
  margin-top: 20rpx;
  padding: 0 24rpx;
}
.recommend .title {
  padding: 20rpx 0;
  font-size: 36rpx;
  color: #333;
  line-height: 50rpx;
  font-weight: 600;
}
.recommend .recd-wrapper {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
}
.recommend .recd-wrapper .recd-item {
  width: 340rpx;
  background-color: #fff;
  padding-bottom: 80rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  position: relative;
}
.recommend .recd-wrapper .recd-item image {
  width: 100%;
  height: 280rpx;
}
.recommend .recd-wrapper .recd-item .name {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333;
  margin-top: 10rpx;
  padding: 0 10rpx;
}
.recommend .recd-wrapper .recd-item .text1,
.recommend .recd-wrapper .recd-item .text2,
.recommend .recd-wrapper .recd-item .text3 {
  font-size: 24rpx;
  line-height: 36rpx;
  margin-top: 6rpx;
  color: #999;
}
.recommend .recd-wrapper .recd-item .text1 {
  margin-left: 10rpx;
}
.recommend .recd-wrapper .recd-item .text2 {
  color: #ebebeb;
  margin: 0 4rpx;
}
.recommend .recd-wrapper .recd-item .text3 {
  color: #666;
}
.recommend .recd-wrapper .recd-item .price-car {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  padding: 0 10rpx;
  width: 100%;
  box-sizing: border-box;
}
.recommend .recd-wrapper .recd-item .price-car .current {
  font-size: 32rpx;
  color: #f6692b;
  line-height: 44rpx;
}
.recommend .recd-wrapper .recd-item .price-car .old {
  font-size: 24rpx;
  line-height: 36rpx;
  color: #ccc;
  text-decoration: line-through;
  margin-left: 16rpx;
}
.recommend .recd-wrapper .recd-item .price-car .cart {
  position: absolute;
  top: -6rpx;
  right: 10rpx;
  font-size: 36rpx !important;
  color: #ffbc19 !important;
}
.recommend .recd-wrapper .recd-item .price-car .cart .uni-icons {
  font-size: 36rpx !important;
  color: #ffbc19 !important;
}
