#notice {
  min-height: 100vh;
  background-color: #fafafa;
  padding: 30rpx 24rpx;
  box-sizing: border-box;
}
.empty {
  text-align: center;
}
.empty image {
  width: 250rpx;
  height: 220rpx;
  margin-top: 250rpx;
}
.empty .tip {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #ccc;
  margin-top: 20rpx;
  text-align: center;
}
.empty .btn {
  font-size: 28rpx;
  color: #fff;
  line-height: 40rpx;
  padding: 10rpx 44rpx !important;
  background-color: #ffcf5a;
  border-radius: 4rpx;
  margin-top: 60rpx;
  display: inline-block;
  border: none !important;
}
.empty .btn:active {
  opacity: 0.8;
}
.notice-item {
  background-color: #fff;
  box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.05);
  padding: 0 30rpx;
  position: relative;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}
.notice-item image {
  width: 40rpx;
  height: 34rpx;
  position: absolute;
  top: 36rpx;
  left: 32rpx;
}
.notice-item .title {
  font-size: 30rpx;
  color: #333;
  line-height: 44rpx;
  padding: 30rpx 0 30rpx 60rpx;
  font-weight: 600;
}
.notice-item .content {
  background-color: #fafafa;
  padding: 30rpx;
}
.notice-item .content .text {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #999;
  text-align: justify;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  word-wrap: break-word;
}
.notice-item .bot {
  padding: 30rpx 0;
  overflow: hidden;
}
.notice-item .jituan,
.notice-item .time {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #666;
}
.notice-item .time {
  float: right;
}
