<view id="author"><block wx:if="{{!isLogin}}"><view><view class="bd-content"><image class="u-img" src="../../static/img/login.png" mode></image><view class="text1">和喜慧管家申请获得以下权限</view><view class="text2">获得你的微信公开信息(昵称、头像等)</view><view class="forget-btn"><button class="wx-btn" disabled="{{btnDisabled}}" open-type="getPhoneNumber" data-event-opts="{{[['getphonenumber',[['getphonenumber',['$event']]]]]}}" bindgetphonenumber="__e">登录授权</button></view></view></view></block><block wx:if="{{isLogin&&!isLoading}}"><view><block wx:if="{{type==3}}"><view class="bd-content"><image class="u-img" src="../../static/img/author.png" mode></image><view class="text1">{{"尊敬的"+(roomObj.villagename?roomObj.villagename:'')+"业主"}}</view><view class="text2">{{"您的管家"+roomObj.housekeeper_name+"邀您绑定房产："}}</view><view class="text3">{{(roomObj.villagename?roomObj.villagename:'')+"\n\t\t\t\t房号："+(roomObj.roomnum?roomObj.roomnum:'')}}</view><view class="forget-btn"><button class="wx-btn" disabled="{{btnDisabled}}" data-event-opts="{{[['tap',[['userAuthor',['$event']]]]]}}" bindtap="__e">绑定房产</button></view></view></block><block wx:else><view class="wg-wrapper"><view class="wg-content"><view class="header">{{costObj.village.villageaddr+costObj.village.villagename+" — 收款方"}}</view><block wx:if="{{type==1}}"><view class="wy-wrapper"><block wx:if="{{$root.g0}}"><view class="qf-content"><view class="title">物业欠费</view><view class="hd"><text>欠费金额(元)</text><text>欠费月份</text><text>欠费科目</text></view><block wx:for="{{costObj.wg}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view class="qf-item"><text class="money">{{item.money}}</text><text class="month">{{item.ymonth}}</text><text class="object">物业费</text></view></block></view></block><block wx:if="{{costObj.wg_yj&&costObj.wg_yj.money}}"><view class="yj-content"><view class="title">物业预缴</view><view class="hd"><text>预缴金额(元)</text><text>开始月份</text><text>预缴数量(月)</text></view><view class="qf-item"><text class="money">{{costObj.wg_yj.money}}</text><text class="month">{{costObj.wg_yj.ymonth}}</text><text class="object">{{costObj.wg_yj.num}}</text></view></view></block></view></block><block wx:else><view class="car-wrapper"><block wx:if="{{$root.g1}}"><view class="qf-content"><view class="title">车辆欠费</view><block wx:for="{{costObj.car}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="car-wrapper"><view class="cname">{{costObj.plates}}</view><view class="hd"><text>欠费金额(元)</text><text>欠费月份</text><text>欠费科目</text></view><block wx:for="{{item.car}}" wx:for-item="itm" wx:for-index="__i1__" wx:key="id"><view class="qf-item"><text class="money">{{itm.money}}</text><text class="month">{{itm.ymonth}}</text><text class="object">车位费</text></view></block></view></block></view></block><view class="yj-content"><view class="title">车辆预缴</view><view class="car-wrapper"><view class="cname">{{costObj.plates}}</view><view class="hd"><text>预缴金额(元)</text><text>开始月份</text><text>预缴数量(月)</text></view><view class="qf-item"><text class="money">{{costObj.car_yj.money}}</text><text class="month">{{costObj.car_yj.ymonth}}</text><text class="object">{{costObj.car_yj.num}}</text></view></view></view></view></block><view class="total"><text class="tx1">收款合计：</text><text class="tx2">{{(costObj.paymoney?costObj.paymoney:'0.00')+"元"}}</text></view><view class="forget-btn"><button data-event-opts="{{[['tap',[['userAuthor',['$event']]]]]}}" class="wx-btn" bindtap="__e">立即支付</button></view></view></view></block></view></block></view>