<view class="uni-padding-wrap"><view><view style="background:#FFF;padding:50rpx 0;border-radius:10rpx;"><view class="uni-hello-text uni-center">支付金额</view><view class="uni-h1 uni-center uni-common-mt"><text class="rmbLogo">￥</text><input class="price" type="number" maxlength="10" disabled="true" value="{{orderInfo.money}}"/></view></view></view><view class="pay-type">请选择支付方式</view><view class="type-select"><block wx:if="{{type=='1'}}"><view class="payment-content"><block wx:if="{{payData.wechatPay||payData.aliPay}}"><view data-event-opts="{{[['tap',[['toBalance',['$event']]]]]}}" class="payment-content-cell" style="justify-content:space-between;" bindtap="__e"><view class="payment-content-cell" style="border:none;"><image class="pay-icon" src="/static/images/balance.png" mode="aspectFit"></image><view class="{{['uni-cell-lineheight-80',(payData.balance<orderInfo.money)?'uni-text-gray':'']}}" loading="{{item.loading}}">{{'当前余额 ： '+payData.balance}}</view><block wx:if="{{payData.balance<orderInfo.money}}"><view class="uni-cell-lineheight-80 uni-text-gray"> (余额不足) </view></block></view><block wx:if="{{payData.balance>orderInfo.money||payData.balance==orderInfo.money}}"><view class="uni-cell-lineheight-80" style="margin:10rpx;"> 余额支付 </view></block></view></block></view></block><view class="payment-content"><block wx:for="{{providerList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{item.id=='wxpay'&&payData.wechatPay==true||item.id=='alipay'&&payData.aliPay==true}}"><view data-event-opts="{{[['tap',[['requestPayment',['$0',index],[[['providerList','',index]]]]]]]}}" class="{{['payment-content-cell',(disabled==true)?'po-event-none':'']}}" bindtap="__e"><image class="pay-icon" src="{{'/static/images/'+item.id+'.png'}}" mode="aspectFit"></image><view class="uni-cell-lineheight-80" loading="{{item.loading}}">{{item.name}}</view></view></block></block></view></view></view>