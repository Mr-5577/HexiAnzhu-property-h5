.bound-house {
  min-height: 100vh;
  background-color: #fff;
  padding-bottom: 160rpx;
}
.build_content {
  width: 100%;
  background: #ffffff;
}
.change-build {
  display: flex;
  height: 120rpx;
  border-bottom: 2rpx solid #ebebeb;
  line-height: 120rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}
.change-build input {
  height: 120rpx;
  line-height: 120rpx;
}
.last-list {
  border-bottom: 30rpx solid #ebebeb;
}
.last-list .change-build {
  border-bottom: none;
}
.cat-label .container {
  padding: 20rpx 36rpx !important;
}
.cat-label .container > .text {
  display: none;
}
.cat-label .container .data {
  width: 680rpx !important;
}
.cat-label .container input {
  padding: 0 10rpx;
}
.information {
  margin-top: 40rpx;
}
.information .title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  line-height: 44rpx;
  width: 90%;
  margin: 0 auto 20rpx;
}
.information .title.t2 {
  margin-top: 60rpx;
}
.color-font-gray {
  padding: 30rpx;
  color: #ffcf5a;
  font-size: 24rpx;
  line-height: 34rpx;
}
.foot {
  padding: 40rpx 0 60rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 100;
  background-color: #fff;
  width: 100%;
}
.foot-btn {
  width: 92%;
  background-color: #ffcf5a !important;
  color: #fff !important;
  font-size: 28rpx;
  line-height: 40rpx;
  border-radius: 8rpx;
  border: none !important;
  padding: 24rpx 0;
}
.foot-btn:active {
  opacity: 0.8;
}
