#order-detail {
  min-height: 100vh;
  background-color: #fafafa;
  padding: 30rpx 24rpx;
  box-sizing: border-box;
}
#order-detail .detail-wrapper {
  background-color: #fff;
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.05);
  padding: 40rpx 30rpx 60rpx;
  border-radius: 10rpx;
}
#order-detail .detail-wrapper .money {
  font-size: 32rpx;
  color: #ffcf5a;
  line-height: 44rpx;
  text-align: center;
  font-weight: 600;
}
#order-detail .detail-wrapper .text {
  font-size: 26rpx;
  color: #999;
  line-height: 36rpx;
  margin: 30rpx 0 40rpx;
  text-align: center;
}
#order-detail .detail-wrapper .content {
  padding: 30rpx;
  background-color: #fafafa;
  border-radius: 10rpx;
}
#order-detail .detail-wrapper .content .item {
  display: flex;
  margin-bottom: 30rpx;
}
#order-detail .detail-wrapper .content .item .name {
  font-size: 30rpx;
  line-height: 42rpx;
  color: #999;
}
#order-detail .detail-wrapper .content .item .code {
  flex: 1;
  font-size: 30rpx;
  line-height: 42rpx;
  color: #333;
  text-align: right;
}
#order-detail .detail-wrapper .content .item:last-child {
  margin-bottom: 0;
}
#order-detail .btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30rpx 24rpx 60rpx;
  box-sizing: border-box;
}
#order-detail .btn-wrapper button {
  margin-bottom: 30rpx;
  padding: 24rpx 0;
  font-size: 28rpx !important;
  line-height: 40rpx !important;
}
#order-detail .btn-wrapper button:last-child {
  margin-bottom: 0;
}
#order-detail .btn-wrapper .btn1 {
  background-color: #ffcf5a;
  color: #fff;
  border: none;
}
#order-detail .btn-wrapper .btn2 {
  border-color: #ffcf5a;
  color: #ffcf5a;
  background-color: #fff;
}
#order-detail .btn-wrapper button:active {
  opacity: 0.8;
}
#order-detail .canvas-hide {
  /* 1 */
  position: fixed;
  right: 100vw;
  bottom: 100vh;
  /* 2 */
  z-index: -9999;
  /* 3 */
  opacity: 0;
}
