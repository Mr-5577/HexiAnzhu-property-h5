.repair {
  padding-top: 80rpx;
}
.repair .load {
  text-align: center;
  padding: 30rpx;
  height: 50rpx;
}
.repair .load image {
  width: 50rpx;
  height: 50rpx;
}
.repair .content {
  padding: 30rpx 24rpx;
}
.repair .content .empty {
  text-align: center;
}
.repair .content .empty image {
  width: 250rpx;
  height: 220rpx;
  margin-top: 250rpx;
}
.repair .content .empty .tip {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #ccc;
  margin-top: 20rpx;
  text-align: center;
}
.repair .content .empty .btn {
  font-size: 28rpx;
  color: #fff;
  line-height: 40rpx;
  padding: 10rpx 44rpx !important;
  background-color: #ffcf5a;
  border-radius: 4rpx;
  margin-top: 60rpx;
  display: inline-block;
  border: none !important;
}
.repair .content .empty .btn:active {
  opacity: 0.8;
}
.repair .content .repair-item {
  padding: 30rpx;
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.05);
  display: flex;
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 10rpx;
}
.repair .content .repair-item .left {
  flex: 1;
}
.repair .content .repair-item .left .type {
  font-size: 30rpx;
  line-height: 42rpx;
  color: #333;
  font-weight: 600;
}
.repair .content .repair-item .left .addr,
.repair .content .repair-item .left .date {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #666;
  margin-top: 10rpx;
}
.repair .content .repair-item .right {
  text-align: right;
}
.repair .content .repair-item .right .status {
  display: inline-block;
  font-size: 24rpx;
  line-height: 34rpx;
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
}
.repair .content .repair-item .right .handle {
  margin-top: 56rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #999;
}
.repair .content .repair-item .right .h-user {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #999;
}
.repair .content .repair-item .right .btn {
  display: inline-block;
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  padding: 10rpx 24rpx;
  border-radius: 6rpx;
  margin-top: 46rpx;
  background-color: #ffcf5a;
}
.uni-flex-center {
  background: #ffffff;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 999;
}
.uni-padding-wrap {
  width: 90%;
  padding: 0;
}
