
.evaluate {
	min-height: 100vh;
	box-sizing: border-box;
	padding-bottom: 180rpx;
}
.tip {
	margin-top: 20rpx;
}
.uni-flex-center {
	padding: 0 24rpx;
}
.iconfont {
	font-size: 26px;
	margin: 10rpx;
}
page {
	background: #ffffff;
}
.cleanfloat {
	display: flex;
	padding: 40rpx;
}
.text-input-area {
	width: 100%;
	border: 1rpx solid #eeeeee;
	border-radius: 10rpx;
	padding: 20rpx;
	line-height: 40rpx;
	box-sizing: border-box;
}
.btn-wrapper {
	position: fixed;
	bottom: 0;
	left: 0;
	padding: 30rpx 24rpx 60rpx;
	width: 100%;
	box-sizing: border-box;
}
.my-btn {
	color: #fff!important;
	font-size: 28rpx;
	line-height: 40rpx;
	padding: 24rpx 0;
	background-color: #ffcf5a!important;
	border: none!important;
}
.my-btn:active {
	opacity: 0.8;
}

