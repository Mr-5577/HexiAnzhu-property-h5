<view class="center"><view class="center_box_bg"><view class="base"><block wx:if="{{!userInfo}}"><image class="profily_header" src="{{defaultImg}}"></image></block><block wx:else><image class="profily_header" src="{{userInfo.avatarUrl}}"></image></block><block wx:if="{{hasBoundHouse==true&&hasLogin==true}}"><view><view><text class="tx1">{{myHouse.ownerInfo.realname+' '}}</text><text class="tx2">{{"-"+(' '+myHouse.ownerInfo.city)}}</text></view><view></view><view><text class="tx3" style="margin-right:20rpx;">{{myHouse.ownerInfo.villagename}}</text><text class="tx3">{{myHouse.ownerInfo.roomnum}}</text></view></view></block><block wx:if="{{hasBoundHouse==false&&hasLogin==true}}"><view><view><view data-event-opts="{{[['tap',[['getNav',['bound-house']]]]]}}" bindtap="__e"><text>请绑定房产</text></view></view></view></block><block wx:if="{{hasLogin==false}}"><view><view><view data-event-opts="{{[['tap',[['getNav',['login']]]]]}}" bindtap="__e"><text>请登录</text></view></view></view></block><block wx:if="{{hasLogin!=false}}"><image class="base_image" src="/static/fumou-center-template/setting.png" mode data-event-opts="{{[['tap',[['logout',['$event']]]]]}}" bindtap="__e"></image></block></view><view class="order_status"><block wx:for="{{status}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['getNav',['$0'],[[['status','',index,'url']]]]]]]}}" class="status" bindtap="__e"><image class="icon" src="{{item.icon}}" mode="aspectFit"></image><text>{{item.name}}</text></view></block></view><view class="center_menu"><block wx:for="{{menus}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['getNav',['$0'],[[['menus','',index,'url']]]]]]]}}" class="menu_item" bindtap="__e"><image src="{{item.icon}}" mode="aspectFit"></image><text>{{item.name}}</text><uni-icons class="icon" vue-id="{{'681d96c2-1-'+index}}" type="arrowright" bind:__l="__l"></uni-icons></view></block></view></view><view class="uni-empty"><text class="text1"></text> 四川和喜物业服务有限公司--版权所有 <text class="text2"></text></view></view>