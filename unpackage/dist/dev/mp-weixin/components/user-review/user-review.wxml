<view><block wx:for="{{list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view style="margin-top:40rpx;margin-bottom:20rpx;"><view style="display:flex;"><view class="uni-cell-15"><block wx:if="{{item.userpic}}"><image class="user-eval-header" src="{{item.userpic}}" mode="aspectFit"></image></block><block wx:else><image class="user-eval-header" src="{{housekeeprImg}}" mode="aspectFit"></image></block></view><view class="uni-cell-20"><view class="uni-flex-center"><view><view>{{item.username}}</view><view class="uni-font-20 color-font-gray">{{item.ctime}}</view></view></view></view><view class="uni-cell-40"></view><view class="cleanfloat uni-cell-30"><block wx:for="{{item.score}}" wx:for-item="items" wx:for-index="index" wx:key="index"><view class="iconfont iconsolid-star-active _i"></view></block><block wx:for="{{5-item.score}}" wx:for-item="items" wx:for-index="index" wx:key="index"><view class="iconfont iconsolid-star _i"></view></block></view></view><view class="uni-flex-center"><view class="uni-cell-80 uni-font-30 uni-font-bold" style="word-wrap:break-word;">{{item.content}}</view></view></view></block></view>