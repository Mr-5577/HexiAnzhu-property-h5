#about{min-height:100vh;background-color:#fafafa}.uni-text-center{color:#333;font-size:32rpx;line-height:50rpx;font-weight:600}.about-header{height:500rpx;background-color:#fff;margin-bottom:30rpx}.about-logo{height:200rpx;border-radius:20rpx}.center_menu{width:100%;display:inline-block;background-color:#fff;padding:0 24rpx;box-sizing:border-box}.menu_item{font-size:30rpx;line-height:42rpx;border-bottom:1px solid #ebebeb;padding:40rpx 0}.menu_item:last-child{border-bottom:none}.uicon{float:right;vertical-align:middle}.uicon .uni-icons{color:#999!important}