<view id="my-house"><block wx:if="{{!hasBoundHouse}}"><view class="uni-empty">请先添加房产</view></block><view class="house-list"><block wx:for="{{lists}}" wx:for-item="item" wx:for-index="index" wx:key="index"><uni-swipe-action class="{{['swipe-action',item.roomid===currentHouse.roomid?'active':'']}}" vue-id="{{'d04756fc-1-'+index}}" options="{{options2}}" data-event-opts="{{[['^click',[['bindClick',['$0'],[[['lists','',index]]]]]]]}}" catch:click="__e" bind:__l="__l" vue-slots="{{['default']}}"><view data-event-opts="{{[['tap',[['selectRoom',['$0'],[[['lists','',index]]]]]]]}}" class="address-item" bindtap="__e"><view class="p-name">{{item.villageaddr+"—"+item.villagename}}</view><view class="code">{{item.roomnum}}</view><view class="radio"><radio color="#ffcf5a" value="{{item.id}}" checked="{{item.roomid===currentHouse.roomid}}"></radio></view></view></uni-swipe-action></block></view><view class="btn-content"><button class="my-btn1" disabled="{{btnForbidden}}" plain="{{true}}" data-event-opts="{{[['tap',[['changeRoom',['$event']]]]]}}" bindtap="__e">切换房产</button><button class="my-btn2" disabled="{{btnForbidden}}" plain="{{true}}" data-event-opts="{{[['tap',[['toBindHouse',['$event']]]]]}}" bindtap="__e">添加房产</button></view></view>