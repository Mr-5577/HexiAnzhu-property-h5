<view class="repair"><view class="uni-flex-center"><view class="uni-padding-wrap"><uni-segmented-control vue-id="748325bc-1" current="{{current}}" values="{{items}}" style-type="{{styleType}}" active-color="{{activeColor}}" data-event-opts="{{[['^clickItem',[['onClickItem']]]]}}" bind:clickItem="__e" bind:__l="__l"></uni-segmented-control></view></view><block wx:if="{{loading}}"><view class="load"><image src="/static/images/load.gif" mode="aspectFit"></image></view></block><block wx:else><view class="content"><block wx:if="{{$root.g0==0}}"><view class="uni-empty">{{loadingText}}</view></block><block wx:else><view><block wx:for="{{list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['toDetail',['$0'],[[['list','',index]]]]]]]}}" class="repair-item" bindtap="__e"><view class="left"><view class="type">{{item.label==1?item.typename+'(报事)':item.typename+'(投诉)'}}</view><view class="addr">{{''+(item.villagename+' '+item.room)+''}}</view><view class="date">{{''+item.create_time+''}}</view></view><block wx:if="{{item.status==10}}"><view class="right"><view class="h-user">{{"处理人："+item.realname}}</view><view data-event-opts="{{[['tap',[['evaluate',['$0'],[[['list','',index]]]]]]]}}" class="btn" catchtap="__e">评价TA</view></view></block><block wx:else><view class="right"><block wx:if="{{item.status==0}}"><text class="status" style="color:#ffcf5a;background-color:#fcf6e5;">{{item.statusMsg}}</text></block><block wx:else><block wx:if="{{item.status==2}}"><text class="status" style="color:#33b5ff;background-color:rgba(51,181,255,0.1);">{{item.statusMsg}}</text></block><block wx:else><block wx:if="{{item.status==1}}"><text class="status" style="color:#65d8bf;background-color:rgba(101,216,191,0.1);">{{item.statusMsg}}</text></block><block wx:else><block wx:if="{{item.status==10}}"><text class="status" style="color:#ec7f27;background-color:rgba(236,127,39,0.1);">{{item.statusMsg}}</text></block></block></block></block><view class="handle">{{"处理人："+(item.realname?item.realname:"无")}}</view></view></block></view></block></view></block></view></block></view>