<view class="evaluate"><view class="uni-flex-center"><text class="uni-font-36 uni-font-bold">报事已完成</text></view><view class="uni-flex-center tip"><text class="color-font-gray">请评价一下为您服务的员工吧</text></view><view class="uni-flex-center"><view class="cleanfloat uni-cell-50"><block wx:for="{{star}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['activeStar',[index]]]]]}}" class="{{['iconfont','iconsolid-star','_i',(item.active==1)?'iconsolid-star-active':'']}}" bindtap="__e"></view></block></view></view><view class="uni-flex-center"><textarea class="text-input-area" placeholder-style="padding:20px;line-height:40upx" placeholder="请输入您对本次服务的评价或者建议" maxlength="140" data-event-opts="{{[['input',[['__set_model',['','content','$event',[]]]]]]}}" value="{{content}}" bindinput="__e"></textarea></view><view class="btn-wrapper"><button class="my-btn" plain="{{true}}" data-event-opts="{{[['tap',[['sub',['$event']]]]]}}" bindtap="__e">提交评价</button></view></view>