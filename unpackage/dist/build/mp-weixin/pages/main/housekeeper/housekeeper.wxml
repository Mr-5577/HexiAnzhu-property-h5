<view class="housekeeper"><view class="header"><view class="avatar"><image src="{{housekeeper.hpath?'/static/images/avatar.png':'/static/images/avatar.png'}}" mode="aspectFit"></image></view><view class="user-name">{{housekeeper.name}}</view><view class="labels"><block wx:if="{{housekeeper.birthday}}"><text class="lab1">{{$root.m0+"0后"}}</text></block><block wx:if="{{housekeeper.intime}}"><text class="lab2">{{"入职"+$root.m1+"年"}}</text></block><block wx:if="{{housekeeper.stars}}"><text class="lab3">{{"评分"+housekeeper.stars}}</text></block></view><view class="btn-wrapper"><text data-event-opts="{{[['tap',[['call']]]]}}" class="hujiao" bindtap="__e">呼叫管家</text><image src="/static/images/weixin.png" mode="aspectFit" data-event-opts="{{[['tap',[['copyWexin',['$event']]]]]}}" bindtap="__e"></image><text data-event-opts="{{[['tap',[['addReview',['$event']]]]]}}" class="evaluate" bindtap="__e">评价TA</text></view></view><view class="content-wrapper"><uni-segmented-control vue-id="1da4714e-1" current="{{current}}" values="{{items}}" style-type="{{styleType}}" active-color="{{activeColor}}" data-event-opts="{{[['^clickItem',[['onClickItem']]]]}}" bind:clickItem="__e" bind:__l="__l"></uni-segmented-control><block wx:if="{{current==0}}"><view class="eval"><block wx:if="{{$root.g0==0}}"><view style="color:#ccc;text-align:center;">暂无数据！</view></block><block wx:for="{{userViews}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="eval-item"><image src="/static/images/avatar.png" mode="aspectFit"></image><view class="intro-wrapper"><view class="introduce"><text class="name">{{item.username}}</text><text class="date">{{item.ctime}}</text><view class="rate"><uni-rate vue-id="{{'1da4714e-2-'+index}}" readonly="{{true}}" value="{{item.score}}" size="{{16}}" margin="{{5}}" bind:__l="__l"></uni-rate></view></view><view class="eval-text">{{item.content}}</view></view></view></block></view></block><block wx:if="{{current==1}}"><view class="service-area"><block wx:if="{{$root.g1==0}}"><view style="color:#ccc;text-align:center;">暂无数据！</view></block><block wx:else><view><view class="adr-wrapper"><uni-icons class="uicon" vue-id="1da4714e-3" type="location-filled" bind:__l="__l"></uni-icons><text class="title">{{housekeeper.villageinfo?housekeeper.villageinfo.villagename:'无项目名'}}</text></view><view class="b-wrapper"><block wx:for="{{housekeeper.servicearea}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="b-item">{{item+''}}</view></block></view></view></block></view></block></view></view>