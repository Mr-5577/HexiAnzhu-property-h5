.detail-wrapper{min-height:100vh;background-color:#fafafa;padding:30rpx 24rpx;box-sizing:border-box}.detail-wrapper .content{background-color:#fff;box-shadow:0 0 6rpx rgba(0,0,0,.05);padding:0;border-radius:10rpx}.detail-wrapper .content .title{font-size:30rpx;line-height:44rpx;font-weight:600;color:#333;padding:30rpx;text-align:center;border-bottom:1px solid #ebebeb}.detail-wrapper .content .text{padding:30rpx 30rpx 0 30rpx;font-size:30rpx;line-height:42rpx;text-align:justify;color:#333}.detail-wrapper .content .time{font-size:26rpx;color:#666;line-height:36rpx;padding:30rpx;text-align:right}