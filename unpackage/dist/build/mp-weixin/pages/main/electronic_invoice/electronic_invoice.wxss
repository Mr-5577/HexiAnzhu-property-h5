.invoice{min-height:100vh;box-sizing:border-box;background-color:#fafafa;padding:30rpx 24rpx}.invoice .empty{text-align:center}.invoice .empty image{width:250rpx;height:220rpx;margin-top:250rpx}.invoice .empty .tip{font-size:32rpx;line-height:44rpx;color:#ccc;margin-top:20rpx;text-align:center}.invoice .empty .btn{font-size:28rpx;color:#fff;line-height:40rpx;padding:10rpx 44rpx!important;background-color:#ffcf5a;border-radius:4rpx;margin-top:60rpx;display:inline-block;border:none!important}.invoice .empty .btn:active{opacity:.8}.invoice .car-wrapper .car-item{padding:30rpx;background-color:#fff;box-shadow:0 0 6rpx rgba(0,0,0,.05);border-radius:10rpx;position:relative;margin-bottom:30rpx}.invoice .car-wrapper .car-item .plate{font-size:32rpx;color:#333;line-height:44rpx;font-weight:600}.invoice .car-wrapper .car-item .item-wrapper{margin-top:10rpx}.invoice .car-wrapper .car-item .item-wrapper .name,
.invoice .car-wrapper .car-item .item-wrapper .value{display:inline-block;font-size:28rpx;color:#666;line-height:40rpx}.invoice .car-wrapper .car-item .btn-wrapper{position:absolute;top:50%;right:30rpx;-webkit-transform:translateY(-50%);transform:translateY(-50%)}.invoice .car-wrapper .car-item .btn-wrapper image{width:76rpx;height:76rpx;vertical-align:middle}.invoice .car-wrapper .car-item:last-child{margin-bottom:0}