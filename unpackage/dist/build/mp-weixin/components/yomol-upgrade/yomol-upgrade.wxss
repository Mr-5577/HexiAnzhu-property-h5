.mark{position:fixed;top:0;left:0;height:100vh;width:100vw;background:rgba(0,0,0,.6);display:flex;flex-flow:row nowrap;justify-content:center;align-items:center;z-index:1000}.view{width:80vw;height:70vw;background-color:#fff;border-radius:15rpx;display:flex;flex-flow:column;justify-content:flex-start;align-items:center}.title{margin-top:20rpx;color:#c40000;font-weight:700;font-size:38rpx;text-align:center}.tip{margin-top:20rpx;margin-left:30rpx;align-self:flex-start;font-size:32rpx;font-weight:600;color:#000}.scroll{width:100%;height:300rpx;display:flex;flex-flow:column;justify-content:flex-start;align-items:flex-start}.item{margin-left:50rpx;text-align:left;font-size:30rpx}.btns{width:100%;display:flex;flex-flow:row nowrap;justify-content:center;align-items:center;margin-bottom:10rpx}.icon{width:45rpx;height:45rpx;margin-right:10rpx}.sure{padding:10rpx 0;text-align:center;color:#c40000;font-size:30rpx;font-weight:500}.progress{margin-bottom:20rpx}